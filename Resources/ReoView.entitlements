<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Two-way talk records from the microphone. Under the hardened runtime a
	     non-sandboxed app is refused audio input without this, and the refusal
	     is silent: no prompt, no error, just no samples. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
